{
  "identifier": "default",
  "description": "Wild Sync default capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "fs:default",
    "opener:default",
    "shell:allow-open",
    "store:allow-get",
    "store:allow-set",
    "store:allow-save",
    "store:allow-has",
    "store:allow-load",
    "store:allow-clear",
    "autostart:allow-enable",
    "autostart:allow-is-enabled",
    "notification:default",
    "notification:allow-request-permission",
    "notification:allow-check-permissions"
  ]
}
